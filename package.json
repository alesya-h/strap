{
  "name": "strap",
  "version": "0.1.0",
  "description": "Unix-ish modular agentic harness primitives",
  "type": "module",
  "private": true,
  "imports": {
    "#strap/core/*": "./subprojects/core/src/*.js",
    "#strap/providers/*": "./subprojects/providers/src/*.js",
    "#strap/tools/*": "./subprojects/tools/src/*.js",
    "#strap/mcp/*": "./subprojects/mcp/src/*.js",
    "#strap/jsmcp/*": "./subprojects/jsmcp/src/*.js",
    "#strap/porcelain/*": "./subprojects/porcelain/src/*.js",
    "#strap/loop/*": "./subprojects/loop/src/*.js",
    "#strap/policy/*": "./subprojects/policy/src/*.js"
  },
  "bin": {
    "strap": "./bin/strap"
  },
  "scripts": {
    "check": "./scripts/check",
    "smoke": "./scripts/smoke",
    "test": "npm run check && npm run smoke"
  },
  "engines": {
    "node": ">=20"
  }
}
