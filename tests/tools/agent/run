#!/usr/bin/env nu
use ../../lib/test.nu *

let pushed = (tool-state agent.context_push { label: "tool scope" } | pipe-json [run-calls --tools agent])
ok (($pushed.history | last).kind == "context") "agent.context_push appends runtime context"
let requested = ($pushed | update history { append { from: "model", calls: [{ id: "pop", tool: "agent.context_pop", input: { summary: "scope summary" } }] } })
let popped = ($requested | pipe-json [run-calls --tools agent])
let last = ($popped.history | last)
ok ($last.calls.0.output.summary == "scope summary") "agent.context_pop returns summary"
