#!/usr/bin/env nu
use ../../lib/test.nu *

let skills = (call-json [skills list])
ok (($skills | any {|item| $item.name == "concise" })) "concise skill is listed"
let skill = (call-json [skills show concise])
has $skill.instructions "concise" "skill instructions are returned"
let state = (call-json [state init] | pipe-json [skills apply concise])
ok ("concise" in $state.actors.assistant.skills) "skill applies to assistant actor"
