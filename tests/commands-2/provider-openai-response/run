#!/usr/bin/env nu
use ../../lib/test.nu *
use ../../../commands/provider-openai/lib/compile.nu *

let chat_event = (response-event {
  id: "chat_fixture"
  model: "openai-chat-fixture"
  choices: [{ message: { content: "", tool_calls: [{ id: "call_oa_chat", type: "function", function: { name: "json_echo__echo", arguments: '{"value":"openai-chat-fixture"}' } }] } }]
  usage: {}
} "chat")
ok ($chat_event.calls.0.input.value == "openai-chat-fixture") "openai chat parser decodes tool arguments"

let responses_event = (response-event {
  id: "resp_fixture"
  model: "openai-responses-fixture"
  output_text: ""
  output: [{ type: "function_call", id: "fc_1", call_id: "call_oa_resp", name: "json_echo__echo", arguments: '{"value":"openai-responses-fixture"}' }]
  usage: {}
} "responses")
ok ($responses_event.calls.0.tool == "json_echo.echo") "openai responses parser decodes provider-safe tool name"
ok ($responses_event.calls.0.input.value == "openai-responses-fixture") "openai responses parser decodes tool arguments"
