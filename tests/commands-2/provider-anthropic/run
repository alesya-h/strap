#!/usr/bin/env nu
use ../../lib/test.nu *

paid-only "Anthropic provider calls require --with-paid-providers"
let state = (state-with-user "Reply with exactly STRAP_ANTHROPIC_OK and no extra words.")
let compiled = ($state | pipe-json [provider-anthropic compile --model claude-sonnet-4.5-anthropic --tools none])
ok ($compiled.model | str contains "claude") "anthropic compile selects Claude model"
let completed = ($state | pipe-json [provider-anthropic complete --model claude-sonnet-4.5-anthropic --tools none])
non-empty (($completed.root.children | last).text) "anthropic complete returns text"
