#!/usr/bin/env nu
use ../../lib/test.nu *

let state = (state-with-user "Reply with exactly STRAP_LLM_OK and no extra words.")
let compiled = ($state | pipe-json [llm compile --tools none])
ok ($compiled.model == "gpt-5.5") "llm compile uses current ChatGPT model"
let completed = ($state | pipe-json [llm complete --tools none])
let last = ($completed.history | last)
ok ($last.from == "model") "llm complete appends model event"
non-empty $last.text "llm complete returns model text"
has $last.text "STRAP_LLM_OK" "llm complete returns requested sentinel"
