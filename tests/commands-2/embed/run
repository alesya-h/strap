#!/usr/bin/env nu
use ../../lib/test.nu *

let openrouter = ({ texts: ["embedding command test"] } | pipe-json [embed --provider openrouter])
ok ($openrouter.model == "nvidia/llama-nemotron-embed-vl-1b-v2:free") "embed openrouter uses configured free model"
ok (($openrouter.embeddings | length) > 0) "embed openrouter returns at least one vector"
ok (($openrouter.embeddings.0 | length) > 0) "embed openrouter vector is non-empty"
let hash = ({ texts: ["embedding command test"] } | pipe-json [embed --provider hash])
ok (($hash.embeddings.0 | length) > 0) "embed hash provider remains available for deterministic local embeddings"
