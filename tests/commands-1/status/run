#!/usr/bin/env nu
use ../../lib/test.nu *

let status = (call-json [status])
ok (($status.roots.layers | any {|layer| $layer.name == "root" and $layer.path == $env.STRAP_ROOT })) "status reports root layer"
ok (($status.artifacts.command | any {|item| $item.name == "state" })) "status reports command artifacts"
let with_paths = (call-json [status --paths])
ok (($with_paths.roots.layers | length) > 0) "status --paths returns roots"
