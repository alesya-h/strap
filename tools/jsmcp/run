#!/usr/bin/env bash
set -euo pipefail
exec bb -cp "$(dirname "$0")/src" -e '
(require (quote [cheshire.core :as json]) (quote [run-calls.jsmcp :as jsmcp]))
(defn read-json [] (json/parse-string (slurp *in*) true))
(defn write-json [x] (println (json/generate-string x {:pretty true})))
(let [args *command-line-args*]
  (if (empty? args)
    (write-json (sort (keys jsmcp/tools)))
    (let [action (first args) env (read-json) own (or (:own_state env) {}) state (atom {:runtime {:jsmcp own}}) f (get jsmcp/tools action)]
      (when-not f (throw (ex-info (str "Unknown jsmcp action: " action) {})))
      (try
        (write-json {:result (f (:arguments env) {:state state}) :own_state (get-in @state [:runtime :jsmcp])})
        (catch Exception e
          (write-json {:error (.getMessage e) :own_state (get-in @state [:runtime :jsmcp])}))))))
' -- "$@"
