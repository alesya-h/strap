{
  "context_push": {
    "description": "Add a runtime context marker to the active state.",
    "process_state": "full",
    "inputSchema": {
      "type": "object",
      "properties": {
        "label": { "type": "string", "description": "Context label" }
      },
      "required": ["label"],
      "additionalProperties": false
    }
  },
  "context_pop": {
    "description": "Add a runtime context summary to the active state.",
    "process_state": "full",
    "inputSchema": {
      "type": "object",
      "properties": {
        "summary": { "type": "string", "description": "Visible context summary" }
      },
      "required": ["summary"],
      "additionalProperties": false
    }
  }
}
