#!/usr/bin/env bb
(require '[cheshire.core :as json])
(defn -main [& args]
  (if (empty? args)
    (println (json/generate-string ["echo"] {:pretty true}))
    (let [env (json/parse-string (slurp *in*) true)]
      (println (json/generate-string {:result {:content [{:type "text" :text (json/generate-string (:arguments env))}]}} {:pretty true})))))
(apply -main *command-line-args*)
