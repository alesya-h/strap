#!/usr/bin/env nu

def main [action?: string] {
  if ($action | is-empty) {
    print ([echo] | to json)
    return
  }

  if $action != "echo" {
    error make {msg: $"Unknown json_echo action: ($action)"}
  }

  let envelope = (^cat | from json)
  let arguments = ($envelope.arguments? | default {})
  let text = if (($arguments | is-empty)) {
    "No arguments"
  } else {
    $arguments | transpose key value | each {|row|
      $"($row.key): ($row.value | to json --raw)"
    } | str join "\n"
  }

  {
    result: {
      content: [{type: "text", text: $text}]
      structuredContent: $arguments
    }
  } | to json | print
}
