#!/usr/bin/env nu

cd $env.STRAP_ROOT

let strap = ($env.STRAP_ROOT | path join bin strap)
$env.STRAP_WORK = "/tmp/strap-work-smoke"
$env.STRAP_PROJECT = "/tmp/strap-project-smoke"
$env.STRAP_PATH = [
  ($env.STRAP_ROOT | path join .strap)
  $"user=($env.STRAP_WORK)"
  $"project=($env.STRAP_PROJECT)"
] | str join (char esep)
if (($env.STRAP_SESSION? | default "") != "") { hide-env STRAP_SESSION }
rm -rf $env.STRAP_WORK $env.STRAP_PROJECT

def save-result [result: record, out: string, err: string = ""] {
  $result.stdout | save -f $out
  if $err != "" { $result.stderr | save -f $err }
  if $result.exit_code != 0 {
    if $result.stderr != "" { print -e --no-newline $result.stderr }
    exit $result.exit_code
  }
}

def save-call [strap: string, args: list<any>, out: string] {
  let result = (run-external $strap ...($args | each {|arg| $arg | into string }) | complete)
  save-result $result $out
}

def save-filter [strap: string, input_file: string, args: list<any>, out: string] {
  let input = (open --raw $input_file)
  let result = ($input | run-external $strap ...($args | each {|arg| $arg | into string }) | complete)
  save-result $result $out
}

def save-filter-log [strap: string, input_file: string, args: list<any>, out: string, err: string] {
  let input = (open --raw $input_file)
  let result = ($input | run-external $strap ...($args | each {|arg| $arg | into string }) | complete)
  save-result $result $out $err
}

def with-hash [block: closure] {
  with-env { STRAP_ZK_EMBED_PROVIDER: "hash" } $block
}

save-call $strap [state init] /tmp/strap-smoke.json
save-filter $strap /tmp/strap-smoke.json [state add-user hello] /tmp/strap-smoke-2.json
save-filter $strap /tmp/strap-smoke-2.json [state add-model world] /tmp/strap-smoke-3.json
save-filter-log $strap /tmp/strap-smoke-3.json [state bookmark add --text hello --label smoke-start] /tmp/strap-smoke-bm-1.json /tmp/strap-smoke-bm-1.log
save-filter-log $strap /tmp/strap-smoke-bm-1.json [state bookmark add --text world --label smoke-end] /tmp/strap-smoke-bm-2.json /tmp/strap-smoke-bm-2.log
save-filter $strap /tmp/strap-smoke-bm-2.json [state bookmark list] /tmp/strap-smoke-bookmarks.json
let bm_start = (open /tmp/strap-smoke-bm-2.json | get history.0.bookmarks.0.id)
let bm_end = (open /tmp/strap-smoke-bm-2.json | get history.1.bookmarks.0.id)
save-filter $strap /tmp/strap-smoke-bm-2.json [state fold --from $bm_start --to $bm_end --summary "smoke folded hello/world"] /tmp/strap-smoke-folded-range.json
save-filter $strap /tmp/strap-smoke-bm-2.json [state extract --from $bm_start --to $bm_end] /tmp/strap-smoke-context.json
save-filter $strap /tmp/strap-smoke-context.json [context quote] /tmp/strap-smoke-quote.json
save-filter $strap /tmp/strap-smoke-quote.json [context summarize "Summarize quoted smoke context" --agent chat-concise --skill concise --dry-run] /tmp/strap-smoke-context-summary.json
save-filter $strap /tmp/strap-smoke-folded-range.json [state tree --hidden] /tmp/strap-smoke-tree.txt
save-filter $strap /tmp/strap-smoke-2.json [llm compile --model gpt-5.1-openai] /tmp/strap-model-openai.json
save-filter $strap /tmp/strap-smoke-2.json [llm compile --model openai-gpt-5.1-openrouter] /tmp/strap-model-openrouter.json
save-filter $strap /tmp/strap-smoke-2.json [llm compile --model claude-sonnet-4.5-anthropic] /tmp/strap-model-anthropic.json
save-filter $strap /tmp/strap-smoke-2.json [llm compile] /tmp/strap-model-current.json
save-call $strap [provider list] /tmp/strap-provider-list.json
save-filter $strap /tmp/strap-smoke-2.json [provider chatgpt compile] /tmp/strap-provider-chatgpt-compile.json
save-filter $strap /tmp/strap-smoke-2.json [provider openai compile --model gpt-5.1-openai] /tmp/strap-provider-openai-compile.json
save-filter $strap /tmp/strap-smoke-2.json [agent fork --prompt "inspect docs"] /tmp/strap-child.json
save-filter $strap /tmp/strap-smoke-2.json [agent fold --child /tmp/strap-child.json --summary "child result"] /tmp/strap-folded.json
run-external $strap ...[state init] | run-external $strap ...[loop --max-turns 0 --finalize false] | save -f /tmp/strap-loop-noop.json

save-filter $strap /tmp/strap-smoke-bm-2.json [state with-events -- jq "map(select(.from == \"user\"))"] /tmp/strap-process-with-events.json
save-filter $strap /tmp/strap-smoke-bm-2.json [state map-events -- jq ". + {reviewed: true}"] /tmp/strap-process-map-events.json
save-filter $strap /tmp/strap-smoke-bm-2.json [state with-extract $bm_start $bm_end -- jq "map(.text |= ascii_upcase)"] /tmp/strap-process-with-extract.json

save-call $strap [commands list --json] /tmp/strap-commands.json
save-call $strap [commands validate --json] /tmp/strap-commands-validate.json
save-call $strap [agents list] /tmp/strap-agents-list.json
save-call $strap [agents show chat-concise] /tmp/strap-agents-show.json
run-external $strap ...[state init] | run-external $strap ...[agents apply chat-concise] | save -f /tmp/strap-agents-apply.json
save-call $strap [skills list] /tmp/strap-skills-list.json
save-call $strap [skills show concise] /tmp/strap-skills-show.json
run-external $strap ...[state init] | run-external $strap ...[agents apply chat-concise] | run-external $strap ...[skills apply concise] | save -f /tmp/strap-skills-apply.json
save-call $strap [model list] /tmp/strap-model-list.json
save-call $strap [model show current] /tmp/strap-model-current-show.json
save-call $strap [model fork current smoke-chatgpt --set-model-id smoke-model] /tmp/strap-model-fork.json
save-call $strap [model use smoke-chatgpt] /tmp/strap-model-use.json
save-call $strap [status] /tmp/strap-status.json
save-call $strap [artifact status command] /tmp/strap-artifact-command-status.json
save-call $strap [artifact status agent] /tmp/strap-artifact-agent-status.json
save-call $strap [artifact status skill] /tmp/strap-artifact-skill-status.json
save-call $strap [artifact status model] /tmp/strap-artifact-model-status.json
save-call $strap [artifact workon tool json_echo] /tmp/strap-artifact-workon.json
save-call $strap [artifact discard tool json_echo] /tmp/strap-artifact-discard.json
save-call $strap [work init] /tmp/strap-work-init.json
save-call $strap [session new "smoke session"] /tmp/strap-session-new.json
let session_dir = (open /tmp/strap-session-new.json | get dir)
let session_name = ($session_dir | path basename)
save-call $strap [with-session $session_name $strap session path] /tmp/strap-with-session-path.txt
$env.STRAP_SESSION = $session_dir
save-call $strap [history init] /tmp/strap-history-init.json
save-call $strap [session ask "remember this smoke question"] /tmp/strap-session-ask.json
save-call $strap [session show] /tmp/strap-session-before-copy.json
save-filter-log $strap /tmp/strap-session-before-copy.json [state bookmark add --text "remember this smoke question" --label session-copy-point] /tmp/strap-session-bookmarked.json /tmp/strap-session-bookmark.log
save-filter $strap /tmp/strap-session-bookmarked.json [session save] /tmp/strap-session-save-bookmarked.json
let bm_session = (open /tmp/strap-session-bookmarked.json | get history.0.bookmarks.0.id)
save-call $strap [session copy "smoke copied session" --at $bm_session] /tmp/strap-session-copy.json
$env.STRAP_SESSION = (open /tmp/strap-session-copy.json | get dir)
save-call $strap [session show] /tmp/strap-session-show.json
save-call $strap [session state] /tmp/strap-session-state.txt
save-call $strap [history snapshot --message "smoke session state"] /tmp/strap-history-snapshot.json

run-external $strap ...[state init] | from json | update history { append { from: "model", calls: [{ id: "echo", tool: "json_echo.echo", input: { value: "ok" } }] } } | to json | run-external $strap ...[run-calls --tools json_echo] | save -f /tmp/strap-json-echo-tool.json

rm -f /tmp/strap-zk-smoke.sqlite /tmp/strap-zk-smoke.sqlite-shm /tmp/strap-zk-smoke.sqlite-wal
with-hash { save-call $strap [zk create --scope user --title "Local hash memory" --body "Offline smoke indexing works without network." --tags smoke] /tmp/strap-zk-create.json }
with-hash { save-call $strap [zk create --scope project --title "Smoke linked memory" --body "Linked target." --tags smoke] /tmp/strap-zk-linked-create.json }
with-hash { save-call $strap [zk update "Local hash memory" --body "Offline smoke indexing works without network. See [[Smoke linked memory]]."] /tmp/strap-zk-update.json }
save-call $strap [zk backlinks "Smoke linked memory"] /tmp/strap-zk-backlinks.json
save-call $strap [zk links "Local hash memory"] /tmp/strap-zk-links.json
save-call $strap [zk workon "Smoke linked memory"] /tmp/strap-zk-workon.json
save-call $strap [zk promote "Smoke linked memory"] /tmp/strap-zk-promote.json
with-hash { save-call $strap [zk search-hybrid --db /tmp/strap-zk-smoke.sqlite "offline indexing"] /tmp/strap-zk-search.json }
with-hash { save-call $strap [zk list --scope all] /tmp/strap-zk-list.json }
with-hash { save-call $strap [zk tags] /tmp/strap-zk-tags.json }
run-external $strap ...[state init] | from json | update history { append { from: "model", calls: [{ id: "zk", tool: "zk.search_hybrid", input: { db: "/tmp/strap-zk-smoke.sqlite", query: "offline indexing", limit: 2 } }] } } | to json | with-env { STRAP_ZK_EMBED_PROVIDER: "hash" } { run-external $strap ...[run-calls --tools zk] } | save -f /tmp/strap-zk-tool.json

rm -f /tmp/strap-md-zk-smoke.sqlite /tmp/strap-md-zk-smoke.sqlite-shm /tmp/strap-md-zk-smoke.sqlite-wal
with-hash { save-call $strap [zk create --scope user --title "Markdown smoke memory" --body "Markdown zettel source can rebuild the sqlite index." --tags "smoke,markdown"] /tmp/strap-zk-md-create.json }
save-call $strap [zk search "Markdown zettel"] /tmp/strap-zk-md-search.json
with-hash { save-call $strap [zk reindex --scope user --db /tmp/strap-md-zk-smoke.sqlite] /tmp/strap-zk-md-reindex.json }
with-hash { save-call $strap [zk search-hybrid --db /tmp/strap-md-zk-smoke.sqlite "rebuild sqlite index"] /tmp/strap-zk-md-index-search.json }
