#!/usr/bin/env nu

cd $env.STRAP_ROOT

const limit = 150
const exceptions_file = ".strap/config/line-cap-exceptions.txt"

def fail [msg: string] {
  print -e $msg
  exit 1
}

def files-for [patterns: list<string>] {
  $patterns | reduce --fold [] {|pattern, acc| $acc ++ (glob --no-dir $pattern) } | uniq | sort
}

def exception-lines [] {
  if not ($exceptions_file | path exists) { return [] }
  open --raw $exceptions_file | lines | where {|line| ($line | str trim) != "" and not ($line | str starts-with "#") }
}

def check-line-cap [] {
  let exceptions = (exception-lines)
  mut failed = false
  let files = (files-for [bin/strap "cli/**/*" "commands/**/*" "tools/**/*" "tests/**/*" "nu/**/*" ".strap/commands/**/*" ".strap-user/commands/**/*"])
  for file in $files {
    if ($file | str ends-with ".json") { continue }
    let n = (open --raw $file | lines | length)
    if $n <= $limit { continue }
    if ($file in $exceptions) { continue }
    print -e $"File exceeds ($limit)-line cap: ($file) \(($n) lines)"
    $failed = true
  }
  for file in $exceptions {
    if not ($file | path exists) { print -e $"Line-cap exception no longer exists: ($file)"; $failed = true; continue }
    let n = (open --raw $file | lines | length)
    if $n <= $limit { print -e $"Stale line-cap exception under ($limit) lines: ($file) \(($n) lines)"; $failed = true }
  }
  if $failed { exit 1 }
}

def require-missing [paths: list<string>] {
  for file in $paths {
    if ($file | path exists) { fail $"Replaced legacy path should not exist: ($file)" }
  }
}

def rg-forbid [message: string, pattern: string, args: list<string>] {
  let result = (run-external rg ...(["-n", $pattern] ++ $args) | complete)
  if $result.exit_code == 0 { print -e $result.stdout; fail $message }
  if $result.exit_code > 1 { print -e $result.stderr; fail $"rg failed while checking: ($message)" }
}

def check-no-retired-surfaces [] {
  require-missing [
    bin/strap-runner subprojects/cli/commands/porcelain subprojects/porcelain porcelain docs/self-modifying-porcelain.md
    subprojects cli/strap-main subprojects/strap-main subprojects/core subprojects/providers subprojects/jsmcp subprojects/loop subprojects/tools subprojects/zettel subprojects/sessions subprojects/mcp commands/state-bb
    subprojects/tools/bin/run-calls.js subprojects/loop/bin/node-loop.js subprojects/providers/bin/llm.js porcelain/loop.nu
    nu/strap nu/strap.nu
  ]
  if not (glob --no-dir "commands/run-calls/src/**/*.js" | is-empty) { fail "run-calls is a Babashka capsule; JS files must not exist there." }
  if not (glob --no-dir "commands/*/main.nu" | is-empty) { fail "Nu command capsules must use run.nu as the only Nu entrypoint; main.nu is retired." }
  require-missing (files-for ["commands/run-calls/src/run_calls/*_tools.clj" "commands/run-calls/src/run_calls/jsmcp.clj" "commands/run-calls/src/run_calls/registry.clj" "commands/run-calls/src/run_calls/scripts.clj"])
  if not (glob --no-dir "tools/*/src/run_calls/*" | is-empty) { fail "Tool-local code should use tool.* namespaces, not run_calls paths." }
  for file in (glob "tools/*") { if (($file | path type) == "file") { fail $"Tool artifacts must be grouped directories, not flat files: ($file)" } }
}

def check-content-guards [] {
  rg-forbid "Tool-local Clojure namespaces should not live under run-calls.*" "run-calls[.]" [tools "--glob" "*.clj"]
  rg-forbid "Babashka tool run scripts should be thin launchers for tool.main." '^\(require|babashka[.]classpath|cp/add-classpath' [tools "--glob" run]
  rg-forbid "Tool results must not use metadata; use equivalent content and structuredContent." ':metadata|metadata[})]' [tools commands/run-calls "--glob" "*.clj" "--glob" "*.js" "--glob" "*.nu"]
  rg-forbid "Shared #strap/tools imports are retired; use strap tools/run-calls boundaries." "#strap/tools" ["." "--glob" "*.js" "--glob" "*.json" "--glob" "*.md" "--glob" "!.git/**"]
  rg-forbid "Root npm/package entrypoints are retired; use strap project-* commands." "npm test|npm run|package[.]json" ["README.md" "docs" "--glob" "*.md"]
  rg-forbid "Non-MCP Node surfaces are retired; use Nu/Babashka command boundaries instead." '#strap/(core|providers|jsmcp|loop)|\^node' ["." "--glob" "*.js" "--glob" "*.json" "--glob" "*.md" "--glob" "*.nu" "--glob" "*.clj" "--glob" "*.sh" "--glob" "!.git/**" "--glob" "!subprojects/mcp/**"]
  rg-forbid "Nu command run scripts must delegate to run.nu, not main.nu." 'main[.]nu' [commands --glob run]
  rg-forbid "run.nu must not read/write process stdin or stdout." 'open --raw /dev/stdin|\^cat|\bprint\b' [commands --glob run.nu]
  rg-forbid "Command input must be data-in/data-out; do not add generic stdin/file input flags." '[-][-](stdin|file)([^A-Za-z0-9_-]|$)' [commands .strap/commands README.md docs --glob "*.nu" --glob "*.clj" --glob "*.md" --glob run]
}

def check-command-syntax [] {
  for file in (files-for ["commands/*/run" "commands/*/inner/*" "tests/commands-*/*/run" "tests/tools/*/run" ".strap/commands/*/run" ".strap-user/commands/*/run"]) {
    let shebang = (open --raw $file | lines | first | default "")
    if ($shebang | str contains "bash") { run-external bash ...[-n $file] }
    if ($shebang | str contains "node") { run-external node ...[--check $file] }
    if ($shebang | str contains "nu") { run-external nu ...[--ide-check 20 $file] | ignore }
  }
  for file in (files-for ["commands/*/run.nu" "tests/lib/*.nu"]) { run-external nu ...[--ide-check 20 $file] | ignore }
  for file in (glob --no-dir "commands/provider-*/main.nu") { run-external nu ...[--ide-check 20 $file] | ignore }
}

def check-command-surfaces [] {
  mut failed = false
  for dir in ((glob "commands/*") ++ (glob ".strap/commands/*") ++ (glob ".strap-user/commands/*")) {
    if (($dir | path type) != "dir") { continue }
    let run = ($dir | path join run)
    if not ($run | path exists) {
      print -e $"Command capsule missing run: ($dir)"
      $failed = true
      continue
    }
    if not ((^test -x $run | complete).exit_code == 0) { print -e $"Command capsule run is not executable: ($run)"; $failed = true }
    let shebang = (open --raw $run | lines | first | default "")
    if not ($shebang =~ '^#!') { print -e $"Command capsule run missing shebang: ($run)"; $failed = true }
  }
  if $failed { exit 1 }
}

def check-capsule-files [] {
  mut files = []
  for dir in (files-for [".strap/commands/*" ".strap-user/commands/*"]) {
    if (($dir | path basename) | str starts-with "project-") { continue }
    if (($dir | path join run) | path exists) { $files = ($files | append ($dir | path join run)) }
    if (($dir | path join inner) | path exists) { $files = ($files | append (glob --no-dir ($dir | path join inner "*"))) }
  }
  if ($files | is-empty) { return }
  let result = (run-external rg ...(["-n", '#strap/|exec node "?[$]STRAP_ROOT/subprojects|subprojects/.*/(src|bin)/.*[.]js'] ++ $files) | complete)
  if $result.exit_code == 0 { print -e $result.stdout; fail "Capsule command violation: compose through strap commands or strap inner." }
  if $result.exit_code > 1 { print -e $result.stderr; fail "rg failed while checking capsule files" }
}

def expect-exit2 [args: list<string>] {
  let result = (run-external ...$args | complete)
  if $result.exit_code != 2 { print -e $result.stderr; print -e $result.stdout; fail $"Expected exit 2: ($args | str join ' ')" }
}

check-line-cap
for file in (files-for ["commands/mcp/servers/*.js" "commands/mcp/bin/*.js" "commands/mcp/src/*.js"]) { run-external node ...[--check $file] }
check-no-retired-surfaces
check-content-guards
check-command-syntax
check-command-surfaces
check-capsule-files
run-external jq empty commands/mcp/package.json config/strap/config.json ...((glob --no-dir "config/strap/models/*.json") ++ (glob --no-dir "config/strap/tool-groups/*.json") ++ (glob --no-dir "config/strap/zettel/config.json"))
with-env { STRAP_CMD_DIR: "commands/zk" } { expect-exit2 [bb commands/zk/run --help] }
with-env { STRAP_CMD_DIR: "commands/zk" } { expect-exit2 [bb commands/zk/inner/index --help] }
expect-exit2 [bb -cp commands/provider-chatgpt/src -m provider.chatgpt]
expect-exit2 [bb -cp commands/artifact/src -m artifact.main --help]
run-external bb ...[-cp cli/src -e "(require 'main)"]
run-external bb ...[-cp commands/run-calls/src -e "(require 'run-calls.main)"]
with-env { STRAP_CMD_DIR: "commands/status" } { expect-exit2 [bb commands/status/run --help] }
'{"texts":["check"]}' | run-external bb ...[commands/embed/run --provider hash] | from json | ignore
run-external ($env.STRAP_BIN? | default "./bin/strap") tool-contract-check
