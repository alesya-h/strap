#!/usr/bin/env bash
set -euo pipefail
shopt -s nullglob globstar

check_line_cap() {
  local limit=150
  local exceptions_file=.strap/config/line-cap-exceptions.txt
  local failed=0
  local line_count
  local files=(bin/strap bin/strap-runner/**/* scripts/check scripts/smoke subprojects/cli/commands/**/*)

  for file in "${files[@]}"; do
    [ -f "$file" ] || continue
    line_count=$(wc -l < "$file")
    if [ "$line_count" -le "$limit" ]; then continue; fi
    if [ -f "$exceptions_file" ] && grep -Fxq -- "$file" "$exceptions_file"; then continue; fi
    printf 'File exceeds %s-line cap: %s (%s lines)\n' "$limit" "$file" "$line_count" >&2
    failed=1
  done

  if [ -f "$exceptions_file" ]; then
    while IFS= read -r file; do
      case "$file" in ''|'#'*) continue ;; esac
      if [ ! -f "$file" ]; then
        printf 'Line-cap exception no longer exists: %s\n' "$file" >&2
        failed=1
        continue
      fi
      line_count=$(wc -l < "$file")
      if [ "$line_count" -le "$limit" ]; then
        printf 'Stale line-cap exception under %s lines: %s (%s lines)\n' "$limit" "$file" "$line_count" >&2
        failed=1
      fi
    done < "$exceptions_file"
  fi

  [ "$failed" -eq 0 ] || exit 1
}

check_line_cap

js_files=(
  bin/strap
  bin/strap-runner/*.js
  subprojects/mcp/servers/*.js
  subprojects/core/bin/*.js
  subprojects/core/src/*.js
  subprojects/providers/bin/*.js
  subprojects/providers/src/*.js
  subprojects/loop/bin/*.js
  subprojects/tools/bin/*.js
  subprojects/tools/src/*.js
  subprojects/mcp/bin/*.js
  subprojects/mcp/src/*.js
  subprojects/porcelain/bin/*.js
  subprojects/porcelain/src/*.js
  subprojects/zettel/bin/*.js
  subprojects/jsmcp/src/*.js
  subprojects/cli/bin/*.js
  subprojects/cli/commands/*/*.js
  subprojects/sessions/bin/*.js
)
for file in "${js_files[@]}"; do node --check "$file"; done

for file in subprojects/core/bin/artifact.js subprojects/core/bin/status.js subprojects/core/src/artifacts.js subprojects/sessions/bin/session.js subprojects/sessions/bin/history.js; do
  if [ -e "$file" ]; then
    printf 'Replaced legacy JS file should not exist: %s\n' "$file" >&2
    exit 1
  fi
done

nu --commands 'use nu/strap; use nu/plumbing.nu *; source tools/zk; use porcelain/loop.nu *'

command_files=(subprojects/cli/commands/*/run subprojects/cli/commands/*/inner/*)
for file in "${command_files[@]}"; do
  read -r shebang < "$file" || shebang=""
  case "$shebang" in
    *bash*) bash -n "$file" ;;
    *node*) node --check "$file" ;;
    *nu*) nu --ide-check 20 "$file" >/dev/null ;;
  esac
done
for file in subprojects/cli/commands/provider-*/main.nu; do
  [ -f "$file" ] && nu --ide-check 20 "$file" >/dev/null
done
jq empty package.json config/strap/config.json config/strap/models/*.json config/strap/tool-groups/*.json config/strap/zettel/config.json
if bb -cp subprojects/state-bb/src -m strap.state --help >/tmp/strap-bb-help.txt 2>&1; then
  :
else
  code=$?
  test "$code" = 2
fi
if bb subprojects/cli/commands/zk/run --help >/tmp/strap-zk-bb-help.txt 2>&1; then
  :
else
  code=$?
  test "$code" = 2
fi
if bb subprojects/cli/commands/zk/inner/index --help >/tmp/strap-zk-index-bb-help.txt 2>&1; then
  :
else
  code=$?
  test "$code" = 2
fi
if bb -cp subprojects/cli/commands/provider-chatgpt/src -m provider.chatgpt >/tmp/strap-provider-chatgpt-bb-help.txt 2>&1; then
  :
else
  code=$?
  test "$code" = 2
fi
if bb -cp subprojects/cli/commands/artifact/src -m artifact.main --help >/tmp/strap-artifact-bb-help.txt 2>&1; then
  :
else
  code=$?
  test "$code" = 2
fi
if bb subprojects/cli/commands/status/run --help >/tmp/strap-status-bb-help.txt 2>&1; then
  :
else
  code=$?
  test "$code" = 2
fi
printf '{"texts":["check"]}' | bb subprojects/cli/commands/embed/run --provider hash | jq empty
