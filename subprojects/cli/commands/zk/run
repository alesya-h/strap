#!/usr/bin/env bb
(require '[babashka.fs :as fs])

(def cmd-dir
  (or (System/getenv "STRAP_CMD_DIR")
      (str (fs/parent *file*))))

(doseq [file ["core.clj" "notes.clj" "links.clj" "crud.clj" "overlay.clj" "index.clj"]]
  (load-file (str (fs/path cmd-dir "src" "zk" file))))

(apply (resolve 'zk.main/-main) *command-line-args*)
