#!/usr/bin/env bash
set -euo pipefail

profile="readonly"
if [ "${1:-}" = "run" ]; then shift; fi
if [ "${1:-}" = "--profile" ]; then profile="$2"; shift 2; fi
if [ "$#" -eq 0 ]; then
  echo "Usage: strap sandbox run [--profile readonly] -- command args..." >&2
  exit 2
fi
if [ "${1:-}" = "--" ]; then shift; fi
if ! command -v bwrap >/dev/null 2>&1; then
  echo "bubblewrap (bwrap) is required for strap sandbox run" >&2
  exit 127
fi

decision_json="$(STRAP_POLICY="$profile" "$STRAP_ROOT/bin/strap" policy decide --policy "$profile" --action execute --command sandbox 2>/dev/null || true)"
if [ -n "$decision_json" ] && command -v jq >/dev/null 2>&1; then
  decision="$(printf '%s' "$decision_json" | jq -r .decision)"
  if [ "$decision" = "deny" ]; then
    printf '%s
    exit 126
  fi
fi

case "$profile" in
  readonly)
    exec bwrap \
      --ro-bind / / \
      --dev /dev \
      --proc /proc \
      --tmpfs /tmp \
      --bind "$STRAP_WORKSPACE" "$STRAP_WORKSPACE" \
      --chdir "$STRAP_WORKSPACE" \
      "$@"
    ;;
  *)
    echo "Unknown sandbox profile: $profile" >&2
    exit 2
    ;;
esac
