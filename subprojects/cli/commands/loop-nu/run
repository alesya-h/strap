#!/usr/bin/env bash
set -euo pipefail

model="current"
tools="all"
max_turns="8"
finalize="true"
max_tool_calls="64"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --model) model="$2"; shift 2 ;;
    --tools) tools="$2"; shift 2 ;;
    --max-turns) max_turns="$2"; shift 2 ;;
    --finalize) finalize="$2"; shift 2 ;;
    --max-tool-calls) max_tool_calls="$2"; shift 2 ;;
    *) echo "Unknown option: $1" >&2; exit 2 ;;
  esac
done

exec node "$STRAP_ROOT/subprojects/porcelain/bin/porcelain.js" run loop run-model "$model" "$tools" "$max_turns" "$finalize" "$max_tool_calls"
