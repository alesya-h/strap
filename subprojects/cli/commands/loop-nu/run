#!/usr/bin/env bash
set -euo pipefail

provider=""
tools="all"
max_turns="8"
finalize="true"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --provider) provider="$2"; shift 2 ;;
    --tools) tools="$2"; shift 2 ;;
    --max-turns) max_turns="$2"; shift 2 ;;
    --finalize) finalize="$2"; shift 2 ;;
    *) echo "Unknown option: $1" >&2; exit 2 ;;
  esac
done

if [ -z "$provider" ]; then
  echo "Usage: strap loop-nu --provider <provider.json> [--tools all] [--max-turns 8] [--finalize true]" >&2
  exit 2
fi

exec node "$STRAP_ROOT/subprojects/porcelain/bin/porcelain.js" run loop run-provider "$provider" "$tools" "$max_turns" "$finalize"
