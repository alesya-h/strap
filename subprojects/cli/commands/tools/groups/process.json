[
  {
    "name": "shell",
    "description": "Run a bash command in the workspace. Prefer dedicated file/search tools for routine filesystem work.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "description": "Bash command to run"
        },
        "workdir": {
          "type": "string",
          "description": "Workspace-relative working directory"
        },
        "timeout_ms": {
          "type": "integer",
          "description": "Timeout in milliseconds",
          "minimum": 1
        },
        "max_output_bytes": {
          "type": "integer",
          "description": "Maximum output bytes returned to the model",
          "minimum": 1
        },
        "description": {
          "type": "string",
          "description": "Short audit-friendly description of intent"
        },
        "read_only_filesystem": {
          "type": "boolean",
          "description": "Run through bubblewrap with a read-only root filesystem"
        }
      },
      "required": [
        "command"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "nu_eval",
    "description": "Run a Nushell command in the workspace.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "description": "Nushell command to run"
        },
        "workdir": {
          "type": "string",
          "description": "Workspace-relative working directory"
        },
        "timeout_ms": {
          "type": "integer",
          "description": "Timeout in milliseconds",
          "minimum": 1
        },
        "max_output_bytes": {
          "type": "integer",
          "description": "Maximum output bytes returned to the model",
          "minimum": 1
        }
      },
      "required": [
        "command"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "tmux",
    "description": "Run a tmux subcommand. Use narrower tmux_capture and tmux_send when possible.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "subcommand": {
          "type": "string",
          "description": "tmux subcommand, for example list-sessions"
        },
        "arguments": {
          "type": "string",
          "description": "Space-separated arguments"
        },
        "timeout_ms": {
          "type": "integer",
          "description": "Timeout in milliseconds",
          "minimum": 1
        }
      },
      "required": [
        "subcommand"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "tmux_capture",
    "description": "Capture recent text from a tmux pane.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "description": "Optional tmux target pane"
        },
        "lines": {
          "type": "integer",
          "description": "Number of recent lines",
          "minimum": 1
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "tmux_send",
    "description": "Send keys to a tmux pane.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "description": "Optional tmux target pane"
        },
        "text": {
          "type": "string",
          "description": "Text or key name to send"
        },
        "enter": {
          "type": "boolean",
          "description": "Whether to send Enter after text"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    }
  }
]
