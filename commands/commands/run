#!/usr/bin/env nu

use ./run.nu

def emit [] {
  let value = $in
  if (($value | describe) =~ '^string') { print --no-newline $value } else { $value | to json --indent 2 | print }
}

def validate-lines [results: list<any>] {
  $results | each {|result|
    let status = if $result.ok { "ok" } else { "fail" }
    let messages = ($result.errors | append $result.warnings | str join "; ")
    $"($status)\t($result.name)\t($messages)"
  } | str join "\n"
}

def main [command?: string, name?: string, --json, --all] {
  let command = ($command | default "")
  match $command {
    "list" => { run list --json=$json --all=$all | emit }
    "roots" => { run roots | emit }
    "manifest" => { run manifest $name | emit }
    "validate" => {
      let results = if ($name | is-empty) { run validate --json --all=$all } else { run validate $name --json --all=$all }
      if $json { $results | emit } else { print --no-newline (validate-lines $results) }
      if ($results | any {|result| not $result.ok }) { exit 1 }
    }
    "new" => { run new $name | emit }
    _ => { run $command | emit }
  }
}
