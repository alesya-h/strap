#!/usr/bin/env nu

use ./run.nu
alias impl = run

def write-json [] { $in | to json --indent 2 | print }

def call-run [command: string, name: any, paths: bool, actor: string] {
  if ($name | is-empty) { impl $command --paths=$paths --actor $actor } else { impl $command $name --paths=$paths --actor $actor }
}

def main [command?: string, name?: string, --paths, --actor: string = ""] {
  if ($command | default "") == "apply" {
    open --raw /dev/stdin | from json | call-run $command $name $paths $actor | write-json
  } else {
    call-run ($command | default "") $name $paths $actor | write-json
  }
}
