#!/usr/bin/env bash
set -euo pipefail
if ! command -v carapace >/dev/null 2>&1; then
  echo "carapace not found on PATH" >&2
  exit 1
fi
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}"
spec_dir="$config_dir/carapace/specs"
spec_link="$spec_dir/strap.yaml"
spec_target="$STRAP_CMD_DIR/run.yaml"
mkdir -p "$spec_dir"
ln -sf "$spec_target" "$spec_link"
echo "Linked: $spec_link -> $spec_target"
