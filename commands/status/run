#!/usr/bin/env bb
(require '[babashka.fs :as fs]
         '[cheshire.core :as json]
         '[clojure.java.shell :as sh])

(defn env [name]
  (System/getenv name))

(defn path-str [& parts]
  (str (apply fs/path parts)))

(defn json-out [value]
  (println (json/generate-string value {:pretty true})))

(defn usage []
  (binding [*out* *err*]
    (println "Usage: strap status [--paths]"))
  (System/exit 2))

(defn strap-bin []
  (path-str (env "STRAP_ROOT") "bin" "strap"))

(defn run-strap-json [args]
  (let [result (apply sh/sh (concat [(strap-bin)] args))]
    (when-not (zero? (:exit result))
      (throw (ex-info (or (not-empty (:err result)) (not-empty (:out result)) (str "strap exited " (:exit result))) {:args args})))
    (json/parse-string (:out result) true)))

(defn run-zk-status [include-paths]
  (let [args (cond-> ["zk" "status"] include-paths (conj "--paths"))
        result (apply sh/sh (concat [(strap-bin)] args))]
    (if (zero? (:exit result))
      (json/parse-string (or (not-empty (:out result)) "[]") true)
      {:error (or (not-empty (:err result)) (not-empty (:out result)) (str "zk status exited " (:exit result)))})))

(defn roots []
  {:workspace (env "STRAP_WORKSPACE")
   :path (env "STRAP_PATH")
   :layers (run-strap-json ["layers" "list"])})

(defn -main [& args]
  (let [include-paths (boolean (some #{"--paths"} args))]
    (when (some #(not= % "--paths") args)
      (usage))
    (let [artifact-args (cond-> ["artifact" "status"] include-paths (conj "--paths"))
          artifacts (assoc (run-strap-json artifact-args) :zettel (run-zk-status include-paths))]
      (json-out {:roots (roots) :artifacts artifacts}))))

(apply -main *command-line-args*)
