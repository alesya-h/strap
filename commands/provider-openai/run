#!/usr/bin/env elvish
use flag
use ./run provider

var command = ''
var rest = []
if (> (count $args) 0) {
  set command = $args[0]
  set rest = $args[1..]
}

fn invoke {|&model=current &tools=all &dimensions=''|
  var input = (from-json)
  provider:main $input $command &model=$model &tools=$tools &dimensions=$dimensions | to-json
}

flag:call $invoke~ $rest &on-parse-error={|_| fail 'Usage: strap provider openai <compile|call|complete|embed> [args]' }
