#!/usr/bin/env nu

use ./run.nu

def emit [] {
  let value = $in
  if (($value | describe) =~ '^string') { print --no-newline $value } else { $value | to json --indent 2 | print }
}

def main [command?: string, ...framing_parts: string, --title: string = "quoted conversation", --model: string = "current", --agent: string = "", --skill: string = "", --tools: string = "none", --max-turns: int = 8, --dry-run] {
  open --raw /dev/stdin | from json | run ($command | default "") ...$framing_parts --title $title --model $model --agent $agent --skill $skill --tools $tools --max-turns $max_turns --dry-run=$dry_run | emit
}
