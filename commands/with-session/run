#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'Usage: strap with-session <session-name-or-path> <command> [args...]\n' >&2
  exit 2
}

if [[ $# -lt 2 ]]; then
  usage
fi

session=$1
shift

if [[ ${1:-} == "--" ]]; then
  shift
fi

if [[ $# -eq 0 ]]; then
  usage
fi

strap_bin=${STRAP_BIN:-"$STRAP_ROOT/bin/strap"}
export STRAP_SESSION
STRAP_SESSION=$("$strap_bin" session resolve "$session")

exec "$@"
