#!/usr/bin/env nu

use ./run.nu

def read-optional-state [file: string] {
  if $file == "-" { open --raw /dev/stdin | from json } else { null }
}

def main [command?: string, ...args: string, --prompt: string = "", --child: string = "", --summary: string = "", --file: string = "-"] {
  if $file == "-" {
    read-optional-state $file | run ($command | default "") ...$args --prompt $prompt --child $child --summary $summary --file $file | to json --indent 2 | print
  } else {
    run ($command | default "") ...$args --prompt $prompt --child $child --summary $summary --file $file | to json --indent 2 | print
  }
}
