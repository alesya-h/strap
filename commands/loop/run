#!/usr/bin/env nu

use ./run.nu

def read-state [file: string] {
  if $file == "-" { open --raw /dev/stdin | from json } else { open $file }
}

def main [--model: string = "current", --tools: string = "all", --max-turns: int = 8, --no-finalize, --finalize: any = "true", --max-tool-calls: int = 64, --file: string = "-"] {
  read-state $file
  | run --model $model --tools $tools --max-turns $max_turns --no-finalize=$no_finalize --finalize $finalize --max-tool-calls $max_tool_calls
  | to json --indent 2
  | print
}
