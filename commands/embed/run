#!/usr/bin/env bb
(require '[babashka.fs :as fs]
         '[clojure.java.shell :as sh]
         '[clojure.string :as str])

(defn parse-args [args]
  (loop [xs (seq args) opts {}]
    (if-not xs
      opts
      (let [x (first xs)]
        (if (str/starts-with? x "--")
          (recur (nnext xs) (assoc opts (keyword (subs x 2)) (second xs)))
          (recur (next xs) opts))))))

(defn usage []
  (binding [*out* *err*]
    (println "Usage: strap embed [--provider openrouter|openai|...] [--model model] < {\"texts\":[...] }"))
  (System/exit 2))

(defn strap-bin []
  (if-let [root (System/getenv "STRAP_ROOT")]
    (str (fs/path root "bin" "strap"))
    "strap"))

(defn provider-args [provider opts]
  (cond-> [(strap-bin) "provider" provider "embed"]
    (:model opts) (conj "--model" (:model opts))
    (:dimensions opts) (conj "--dimensions" (:dimensions opts))))

(defn delegate-provider [provider opts input]
  (let [res (apply sh/sh (concat (provider-args provider opts) [:in input]))]
    (when-not (zero? (:exit res))
      (throw (ex-info (or (not-empty (:err res)) (not-empty (:out res))
                          (str "provider " provider " embed failed")) {})))
    (print (:out res))))

(defn -main [& args]
  (try
    (when (some #{"--help" "-h"} args) (usage))
    (let [opts (parse-args args)
          provider (or (:provider opts) (System/getenv "STRAP_EMBED_PROVIDER")
                       (System/getenv "STRAP_ZK_EMBED_PROVIDER") "openrouter")]
      (delegate-provider provider opts (slurp *in*)))
    (catch Throwable error
      (binding [*out* *err*]
        (println (or (ex-message error) (.getMessage error))))
      (System/exit 1))))

(apply -main *command-line-args*)
