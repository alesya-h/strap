#!/usr/bin/env bash
set -euo pipefail

provider="${1:-}"
strap_bin=${STRAP_BIN:-"$STRAP_ROOT/bin/strap"}
if [ "$provider" = "list" ]; then
  "$strap_bin" commands list --json --all | jq '[.[].name | select(startswith("provider-")) | sub("^provider-"; "")] | sort'
  exit 0
fi
if [ -z "$provider" ]; then
  printf '%s\n' 'Usage: strap provider <anthropic|chatgpt|openai|openrouter> <command> [args...]' >&2
  printf '%s\n' '       strap provider list' >&2
  exit 2
fi
shift
exec "$strap_bin" "provider-$provider" "$@"
