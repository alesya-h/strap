#!/usr/bin/env bb
(require '[babashka.fs :as fs])

(def cmd-dir
  (or (System/getenv "STRAP_CMD_DIR")
      (str (fs/parent (fs/parent *file*)))))

(doseq [file ["core.clj" "schema.clj" "crud.clj" "search.clj" "main.clj"]]
  (load-file (str (fs/path cmd-dir "src" "zk_index" file))))

(apply (resolve 'zk.index/-main) *command-line-args*)
