#!/usr/bin/env bb
(require '[babashka.fs :as fs])
(require '[babashka.classpath :as cp])

(def cmd-dir
  (or (System/getenv "STRAP_CMD_DIR")
      (str (fs/parent (fs/parent *file*)))))

(cp/add-classpath (str (fs/path cmd-dir "src")))
(require 'zk-index.main)

(apply (resolve 'zk-index.main/-main) *command-line-args*)
