#!/usr/bin/env nu

use ./run.nu

def write-json [] { $in | to json --indent 2 | print }

def main [command?: string, arg1?: string, arg2?: string, --paths, --set-model-id: string = ""] {
  match ($command | default "") {
    "list" => { run list --paths=$paths | write-json }
    "show" => { run show ($arg1 | default "current") --paths=$paths | write-json }
    "current" => { run current --paths=$paths | write-json }
    "roots" => { run roots --paths=$paths | write-json }
    "use" => { run use ($arg1 | default "") --paths=$paths --set-model-id $set_model_id | write-json }
    "fork" => { run fork ($arg1 | default "") ($arg2 | default "") --paths=$paths --set-model-id $set_model_id | write-json }
    _ => { run ($command | default "") }
  }
}
