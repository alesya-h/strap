#!/usr/bin/env nu

use ./run.nu

def read-optional-json [] {
  let raw = (open --raw /dev/stdin)
  if (($raw | str trim) == "") { null } else { $raw | from json }
}

def main [command?: string, ...task_parts: string, --model: string = "current", --agent: string = "", --skill: string = "", --tools: string = "none", --max-turns: int = 8, --finalize: string = "true", --dry-run] {
  read-optional-json | run ($command | default "") ...$task_parts --model $model --agent $agent --skill $skill --tools $tools --max-turns $max_turns --finalize $finalize --dry-run=$dry_run | to json --indent 2 | print
}
